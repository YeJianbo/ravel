+func (s *session) uotDestinationLink(ctx context.Context, st *stream, dest net.Destination, addr M.Socksaddr) (*transport.Link, error) {
+	key := dest.String()
+	st.udpMu.Lock()
+	defer st.udpMu.Unlock()
+	if st.udpClosed {
+		return nil, errors.New("anytls: UDP stream closed")
 	}
+	if link := st.udpLinks[key]; link != nil {
+		return link, nil
+	}
+	if len(st.udpLinks) >= maxUoTDestinations {
+		return nil, errors.New("anytls: too many UDP destinations")
+	}
+	// Each destination needs its own route and mutable outbound metadata.
+	packetCtx := sessionctx.ContextWithOutbounds(s.dispatchContext(ctx, st), []*sessionctx.Outbound{{}})
+	if content := sessionctx.ContentFromContext(packetCtx); content != nil {
+		copy := *content
+		copy.Attributes = maps.Clone(content.Attributes)
+		packetCtx = sessionctx.ContextWithContent(packetCtx, &copy)
+	}
+	link, err := s.dispatcher.Dispatch(packetCtx, dest)
+	if err != nil {
+		return nil, errors.New("anytls: UDP dispatcher error").Base(err)
+	}
+	if st.udpLinks == nil {
+		st.udpLinks = make(map[string]*transport.Link)
+	}
+	st.udpLinks[key] = link
+	go s.pumpUoTDownlink(st.sid, st, link, false, addr)
+	return link, nil
+}
 
