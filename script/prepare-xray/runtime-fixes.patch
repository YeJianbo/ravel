+package buf_test
+
+import (
+	"bytes"
+	. "github.com/xtls/xray-core/common/buf"
+	"testing"
+)
+
+func TestBufferedWriterContinuesAfterPartialBufferWrite(t *testing.T) {
+	var output bytes.Buffer
+	w := NewBufferedWriter(NewWriter(&output))
+	header := []byte("header!")
+	payload := bytes.Repeat([]byte{42}, Size+500)
+	if _, err := w.Write(header); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := w.Write(payload); err != nil || n != len(payload) {
+		t.Fatalf("write=%d, %v", n, err)
+	}
+	if err := w.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	want := append(append([]byte{}, header...), payload...)
+	if !bytes.Equal(output.Bytes(), want) {
+		t.Fatal("buffered payload was truncated")
+	}
+}
