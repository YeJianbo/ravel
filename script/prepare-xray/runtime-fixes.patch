new file mode 100644
index 0000000..65dceb3
--- /dev/null
+++ b/proxy/anytls/uot_regression_test.go
@@ -0,0 +1,149 @@
+package anytls
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"io"
+	"sync"
+	"testing"
+
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/common/uot"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport"
+)
+
+type packetCapture struct{ packets [][]byte }
+
+func (w *packetCapture) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	defer buf.ReleaseMulti(mb)
+	for _, b := range mb {
+		w.packets = append(w.packets, append([]byte{}, b.Bytes()...))
+	}
+	return nil
+}
+func multi(data []byte) buf.MultiBuffer {
+	b := buf.NewWithSize(int32(len(data)))
+	b.Write(data)
+	return buf.MultiBuffer{b}
+}
+func packet(payload []byte, connect bool, dest M.Socksaddr) []byte {
+	var b bytes.Buffer
+	if !connect {
+		uot.AddrParser.WriteAddrPort(&b, dest)
+	}
+	binary.Write(&b, binary.BigEndian, uint16(len(payload)))
+	b.Write(payload)
+	return b.Bytes()
+}
+
+func TestUoTFragmentedAndCoalescedDatagrams(t *testing.T) {
+	for _, connect := range []bool{true, false} {
+		dest := M.ParseSocksaddr("8.8.8.8:443")
+		w := &packetCapture{}
+		st := newStream(1, &transport.Link{Writer: w})
+		st.uotRequest = &uot.Request{IsConnect: connect, Destination: dest}
+		st.udpIsConnect = connect
+		payloads := [][]byte{[]byte("one"), bytes.Repeat([]byte{42}, 12000), {}, []byte("last")}
+		var wire []byte
+		for _, p := range payloads {
+			wire = append(wire, packet(p, connect, dest)...)
+		}
+		s := &session{}
+		// Split inside addresses and lengths, then coalesce the remaining packets.
+		for _, size := range []int{1, 1, 1, 1, 1, 1, 1, 1, len(wire) - 8} {
+			if err := s.handleUDPFrame(context.Background(), st, multi(wire[:size])); err != nil {
+				t.Fatal(err)
+			}
+			wire = wire[size:]
+		}
+		if len(w.packets) != len(payloads) {
+			t.Fatalf("connect=%v: got %d packets", connect, len(w.packets))
+		}
+		for i, p := range payloads {
+			if !bytes.Equal(p, w.packets[i]) {
+				t.Fatalf("connect=%v: packet %d corrupted", connect, i)
+			}
+		}
+	}
+}
+
+type blockedReader struct {
+	done chan struct{}
+	once sync.Once
+}
+
+func (r *blockedReader) ReadMultiBuffer() (buf.MultiBuffer, error) { <-r.done; return nil, io.EOF }
+func (r *blockedReader) Interrupt()                                { r.once.Do(func() { close(r.done) }) }
+
+type captureDispatcher struct {
+	routing.Dispatcher
+	link *transport.Link
+}
+
+func (d *captureDispatcher) Dispatch(context.Context, net.Destination) (*transport.Link, error) {
+	return d.link, nil
+}
+
+func TestUoTRequestCanSpanFrames(t *testing.T) {
+	dest := M.ParseSocksaddr("example.com:443")
+	var request bytes.Buffer
+	uot.WriteRequest(&request, uot.Request{IsConnect: true, Destination: dest})
+	w := &packetCapture{}
+	r := &blockedReader{done: make(chan struct{})}
+	st := newStream(1, nil)
+	s := &session{dispatcher: &captureDispatcher{link: &transport.Link{Reader: r, Writer: w}}, streams: map[uint32]*stream{1: st}}
+	s.closed.Store(true)
+	wire := append(request.Bytes(), packet([]byte("test"), true, dest)...)
+	for _, value := range wire {
+		if err := s.handleUDPFrame(context.Background(), st, multi([]byte{value})); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(w.packets) != 1 || string(w.packets[0]) != "test" {
+		t.Fatalf("bad packets: %q", w.packets)
+	}
+	r.Interrupt()
+}
+
+type batchReader struct{ mb buf.MultiBuffer }
+
+func (r *batchReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	mb := r.mb
+	r.mb = nil
+	if mb == nil {
+		return nil, io.EOF
+	}
+	return mb, nil
+}
+func TestUoTDownlinkPreservesDatagramBoundaries(t *testing.T) {
+	var wire bytes.Buffer
+	payloads := [][]byte{[]byte("first"), bytes.Repeat([]byte{9}, 1400), []byte("third")}
+	var mb buf.MultiBuffer
+	for _, p := range payloads {
+		mb = append(mb, multi(p)...)
+	}
+	link := &transport.Link{Reader: &batchReader{mb}, Writer: &packetCapture{}}
+	st := newStream(1, link)
+	s := &session{fw: newFrameWriter(buf.NewBufferedWriter(buf.NewWriter(&wire))), streams: map[uint32]*stream{1: st}}
+	s.closed.Store(true)
+	s.pumpUoTDownlink(1, st, link, true, M.ParseSocksaddr("8.8.8.8:443"))
+	for i, p := range payloads {
+		var header [7]byte
+		if _, err := io.ReadFull(&wire, header[:]); err != nil {
+			t.Fatal(err)
+		}
+		length := int(binary.BigEndian.Uint16(header[5:]))
+		body := make([]byte, length)
+		io.ReadFull(&wire, body)
+		if len(body) < 2 || int(binary.BigEndian.Uint16(body[:2])) != len(p) || !bytes.Equal(body[2:], p) {
+			t.Fatalf("packet %d lost boundaries", i)
+		}
+	}
+	if wire.Len() != 0 {
+		t.Fatal("unexpected extra frame")
+	}
+}
